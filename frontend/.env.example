# KrushiSense Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored. This file IS safe to commit.

# Formspree form endpoint ID
# Get yours at https://formspree.io (create a form, copy the ID from the URL)
VITE_FORMSPREE_ID=

# App URL (update in production)
VITE_APP_URL=http://localhost:3000

# Backend API URL (leave empty for local dev to use proxy, or set for production)
VITE_API_BASE_URL=
