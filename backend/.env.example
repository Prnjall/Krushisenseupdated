# KrushiSense Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored. This file IS safe to commit.

DEBUG=
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
# Optional: CORS origins for frontend production
CORS_ALLOWED_ORIGINS=https://krushisenseupdated.vercel.app

# Optional: CORS regex for Vercel preview environments
CORS_ALLOWED_ORIGIN_REGEXES=^https://krushisenseupdated-[a-zA-Z0-9\-]+-pranjals-projects-[a-zA-Z0-9]+\.vercel\.app$
CSRF_TRUSTED_ORIGINS=

GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
